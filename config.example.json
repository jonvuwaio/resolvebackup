{
  "backup_dir": "~/ResolveCloudBackups",
  "interval_minutes": 30,
  "retry_minutes": 5,
  "active_hours": ["07:00", "22:00"],
  "database": { "name": null, "type": null },
  "switch_database": false,
  "initial_lookback_days": 7,
  "include": [],
  "exclude": ["*/Scratch*"],
  "with_stills_and_luts": true,
  "load_to_export": "auto",
  "retry_backoff_max_minutes": 120,
  "alert_command": null,
  "alert_after_failures": 3,
  "save_open_project": false,
  "max_exports_per_cycle": 50,
  "pause_between_exports_seconds": 2,
  "min_free_gb": 5,
  "fallback_min_interval_minutes": 120,
  "retention": { "keep_all_hours": 24, "keep_daily_days": 30 },
  "dashboard": { "enabled": true, "port": 8765 },
  "resolve_script_api": null,
  "resolve_script_lib": null
}
